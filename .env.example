# Application
APP_NAME="WebEngine CMS"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=sqlsrv
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=MuOnline
DB_USERNAME=sa
DB_PASSWORD=

# Secondary Database (optional)
DB_SECONDARY_DATABASE=Me_MuOnline

# Session
SESSION_NAME=WebEngine_Slim
SESSION_LIFETIME=7200

# Cache
CACHE_DRIVER=file
CACHE_PATH=../storage/cache

# Email
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@muserver.com
MAIL_FROM_NAME="${APP_NAME}"

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Security
JWT_SECRET=
PASSWORD_ENCRYPTION=sha256

# Server Info
SERVER_NAME="My MU Server"
SERVER_VERSION=Season 6
SERVER_EXP_RATE=1000
SERVER_DROP_RATE=50
SERVER_MAX_RESETS=10
SERVER_TIMEZONE=America/Sao_Paulo
