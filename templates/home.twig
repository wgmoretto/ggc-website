{% extends "layout.twig" %}

{% block title %}Home - {{ server_name }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-8">
        <h1>Welcome to {{ server_name }}</h1>
        <p class="lead">Experience the best MU Online private server!</p>

        <h2>Latest News</h2>
        {% for article in news %}
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">{{ article.title }}</h3>
            </div>
            <div class="panel-body">
                {{ article.content|slice(0, 200) }}...
                <a href="/news/{{ article.id }}">Read more</a>
            </div>
            <div class="panel-footer">
                <small>Posted by {{ article.author }} on {{ article.created_at }}</small>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="col-md-4">
        <div class="panel panel-primary">
            <div class="panel-heading">Server Statistics</div>
            <div class="panel-body">
                <p><strong>Online Players:</strong> {{ online_count }}</p>
                <p><strong>Total Accounts:</strong> {{ total_accounts }}</p>
                <p><strong>Total Characters:</strong> {{ total_characters }}</p>
            </div>
        </div>

        <div class="panel panel-info">
            <div class="panel-heading">Top Players</div>
            <div class="panel-body">
                <table class="table table-condensed">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Name</th>
                            <th>Level</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for player in top_players %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td><a href="/profile/player/{{ player.Name }}">{{ player.Name }}</a></td>
                            <td>{{ player.cLevel }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
