{% extends "layout_with_sidebar.twig" %}

{% block title %}Home - {{ server_name }}{% endblock %}

{% block hero %}
<!-- Hero Slider -->
<div class="hero-slider">
    <div class="slider-content">
        <h1><i class="fa fa-gamepad"></i> Welcome to {{ server_name }}</h1>
        <p>Experience the best MU Online private server with high rates, unique features, and an active community!</p>
        <div>
            <a href="/register" class="btn btn-primary btn-lg"><i class="fa fa-user-plus"></i> Create Account</a>
            <a href="/downloads" class="btn btn-secondary btn-lg"><i class="fa fa-download"></i> Download Client</a>
        </div>
    </div>
</div>
{% endblock %}

{% block main_content %}
<div class="card">
    <div class="card-header">
        <h3><i class="fa fa-newspaper-o"></i> Latest News</h3>
    </div>
    <div class="card-body">
        {% if news %}
            {% for article in news %}
            <div class="news-item">
                <div class="news-title">
                    <a href="/news/{{ article.id }}">{{ article.title }}</a>
                </div>
                <div class="news-meta">
                    <i class="fa fa-user"></i> {{ article.author }}
                    <i class="fa fa-calendar" style="margin-left: 15px;"></i> {{ article.created_at }}
                </div>
                <div class="news-excerpt">
                    {{ article.content|slice(0, 250)|raw }}...
                    <a href="/news/{{ article.id }}" class="text-red"><strong>Read more <i class="fa fa-arrow-right"></i></strong></a>
                </div>
            </div>
            {% endfor %}
        {% else %}
            <p class="text-center" style="padding: 40px 0; color: var(--text-secondary);">
                <i class="fa fa-info-circle fa-3x" style="display: block; margin-bottom: 15px;"></i>
                No news available at the moment. Check back soon!
            </p>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block sidebar %}
{{ parent() }}

<!-- Top Players Widget -->
<div class="widget">
    <div class="widget-title">
        <i class="fa fa-star"></i> Top Players
    </div>
    {% if top_players %}
        <table class="table table-condensed" style="margin-bottom: 0;">
            <thead>
                <tr>
                    <th style="width: 30px;">#</th>
                    <th>Name</th>
                    <th style="text-align: right;">Level</th>
                </tr>
            </thead>
            <tbody>
            {% for player in top_players|slice(0, 5) %}
                <tr>
                    <td><span class="label label-default">{{ loop.index }}</span></td>
                    <td>
                        <a href="/profile/player/{{ player.Name }}" class="text-orange">
                            <strong>{{ player.Name }}</strong>
                        </a>
                    </td>
                    <td style="text-align: right;">
                        <span class="text-red"><strong>{{ player.cLevel }}</strong></span>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div style="text-align: center; margin-top: 15px;">
            <a href="/rankings" class="btn btn-secondary btn-sm">
                View All Rankings <i class="fa fa-arrow-right"></i>
            </a>
        </div>
    {% else %}
        <p class="text-center" style="padding: 20px 0; color: var(--text-secondary);">
            No players yet. Be the first!
        </p>
    {% endif %}
</div>
{% endblock %}
