{% extends "layout.twig" %}

{% block title %}{{ article.title }} - {{ server_name }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><a href="/">Home</a></li>
            <li><a href="/news">News</a></li>
            <li class="active">{{ article.title }}</li>
        </ol>
    </div>
</div>

<div class="panel panel-primary">
    <div class="panel-heading">
        <h3 class="panel-title">{{ article.title }}</h3>
    </div>
    <div class="panel-body">
        <div class="news-content">
            {{ article.content|raw }}
        </div>
    </div>
    <div class="panel-footer">
        <small>
            <i class="fa fa-user"></i> Posted by <strong>{{ article.author }}</strong> |
            <i class="fa fa-calendar"></i> {{ article.created_at }} |
            <i class="fa fa-folder"></i> {{ article.category|capitalize }}
        </small>
    </div>
</div>

<a href="/news" class="btn btn-default">
    <i class="fa fa-arrow-left"></i> Back to News
</a>
{% endblock %}
