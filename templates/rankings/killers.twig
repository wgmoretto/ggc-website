{% extends "layout.twig" %}

{% block title %}PK Rankings - {{ server_name }}{% endblock %}

{% block content %}
<h1><i class="fa fa-crosshairs"></i> Top Killers</h1>

<div class="panel panel-danger">
    <div class="panel-heading">
        <h3 class="panel-title">Player Kill Rankings - Top 100</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Character</th>
                    <th>Class</th>
                    <th>Level</th>
                    <th>PK Count</th>
                </tr>
            </thead>
            <tbody>
            {% for player in rankings %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td><a href="/profile/player/{{ player.Name }}">{{ player.Name }}</a></td>
                    <td>{{ player.ClassName }}</td>
                    <td><span class="label label-success">{{ player.cLevel }}</span></td>
                    <td><span class="label label-danger">{{ player.PkCount }}</span></td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">No PK data available</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<a href="/rankings" class="btn btn-default">
    <i class="fa fa-arrow-left"></i> Back to Rankings
</a>
{% endblock %}
