{% extends "layout.twig" %}

{% block title %}Reset Rankings - {{ server_name }}{% endblock %}

{% block content %}
<h1><i class="fa fa-repeat"></i> Top Reset Players</h1>

<div class="panel panel-success">
    <div class="panel-heading">
        <h3 class="panel-title">Reset Rankings - Top 100</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Character</th>
                    <th>Class</th>
                    <th>Resets</th>
                    <th>Level</th>
                </tr>
            </thead>
            <tbody>
            {% for player in rankings %}
                <tr>
                    <td>
                        {% if loop.index <= 3 %}
                            <i class="fa fa-trophy" style="color: {% if loop.index == 1 %}gold{% elseif loop.index == 2 %}silver{% else %}#CD7F32{% endif %};"></i>
                        {% else %}
                            {{ loop.index }}
                        {% endif %}
                    </td>
                    <td><a href="/profile/player/{{ player.Name }}">{{ player.Name }}</a></td>
                    <td>{{ player.ClassName }}</td>
                    <td><span class="label label-primary">{{ player.Resets|default(0) }}</span></td>
                    <td><span class="label label-success">{{ player.cLevel }}</span></td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">No rankings available</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<a href="/rankings" class="btn btn-default">
    <i class="fa fa-arrow-left"></i> Back to Rankings
</a>
{% endblock %}
