{% extends "rankings_layout.twig" %}

{% set current_ranking = 'resets' %}
{% set ranking_icon = 'refresh' %}

{% block ranking_title %}Top Reset Players{% endblock %}

{% block ranking_content %}
<div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Character</th>
                    <th>Class</th>
                    <th>Resets</th>
                    <th>Level</th>
                </tr>
            </thead>
            <tbody>
            {% for player in rankings %}
                <tr>
                    <td>
                        {% if loop.index == 1 %}
                            <i class="fa fa-trophy fa-lg" style="color: #FFD700;"></i>
                            <span class="text-orange" style="font-weight: bold; margin-left: 5px;">1st</span>
                        {% elseif loop.index == 2 %}
                            <i class="fa fa-trophy fa-lg" style="color: #C0C0C0;"></i>
                            <span class="text-orange" style="font-weight: bold; margin-left: 5px;">2nd</span>
                        {% elseif loop.index == 3 %}
                            <i class="fa fa-trophy fa-lg" style="color: #CD7F32;"></i>
                            <span class="text-orange" style="font-weight: bold; margin-left: 5px;">3rd</span>
                        {% else %}
                            {{ loop.index }}
                        {% endif %}
                    </td>
                    <td>
                        <a href="/profile/player/{{ player.Name }}" class="text-orange">
                            <strong>{{ player.Name }}</strong>
                        </a>
                    </td>
                    <td><span class="text-secondary">{{ player.ClassName }}</span></td>
                    <td style="text-align: center;">
                        <span class="label label-primary" style="font-size: 13px; padding: 5px 12px;">
                            {{ player.Resets|default(0) }}
                        </span>
                    </td>
                    <td style="text-align: center;">
                        <span class="label label-success" style="font-size: 13px; padding: 5px 12px;">
                            {{ player.cLevel }}
                        </span>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center" style="padding: 40px 0;">
                        <i class="fa fa-info-circle fa-3x text-secondary" style="display: block; margin-bottom: 15px;"></i>
                        <span style="color: var(--text-secondary);">No rankings available</span>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
