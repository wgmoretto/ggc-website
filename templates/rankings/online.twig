{% extends "layout.twig" %}

{% block title %}Online Players - {{ server_name }}{% endblock %}

{% block content %}
<h1><i class="fa fa-circle" style="color: green;"></i> Online Players</h1>

<div class="panel panel-warning">
    <div class="panel-heading">
        <h3 class="panel-title">Currently Online - {{ rankings|length }} Players</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Character</th>
                    <th>Class</th>
                    <th>Level</th>
                    <th>Resets</th>
                    <th>Map</th>
                </tr>
            </thead>
            <tbody>
            {% for player in rankings %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>
                        <i class="fa fa-circle" style="color: green; font-size: 8px;"></i>
                        <a href="/profile/player/{{ player.Name }}">{{ player.Name }}</a>
                    </td>
                    <td>{{ player.ClassName }}</td>
                    <td><span class="label label-success">{{ player.cLevel }}</span></td>
                    <td><span class="label label-info">{{ player.Resets|default(0) }}</span></td>
                    <td>{{ player.MapNumber }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">No players currently online</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<a href="/rankings" class="btn btn-default">
    <i class="fa fa-arrow-left"></i> Back to Rankings
</a>
{% endblock %}
