{% extends "layout.twig" %}

{% block title %}Grand Reset Rankings - {{ server_name }}{% endblock %}

{% block content %}
<h1><i class="fa fa-bolt"></i> Top Grand Reset Players</h1>

<div class="panel panel-success">
    <div class="panel-heading">
        <h3 class="panel-title">Grand Reset Rankings - Top 100</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Character</th>
                    <th>Class</th>
                    <th>Grand Resets</th>
                    <th>Resets</th>
                    <th>Level</th>
                </tr>
            </thead>
            <tbody>
            {% for player in rankings %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td><a href="/profile/player/{{ player.Name }}">{{ player.Name }}</a></td>
                    <td>{{ player.ClassName }}</td>
                    <td><span class="label label-danger">{{ player.GrandResets }}</span></td>
                    <td><span class="label label-primary">{{ player.Resets|default(0) }}</span></td>
                    <td><span class="label label-success">{{ player.cLevel }}</span></td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">No rankings available</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<a href="/rankings" class="btn btn-default">
    <i class="fa fa-arrow-left"></i> Back to Rankings
</a>
{% endblock %}
