{% extends "layout.twig" %}

{% block title %}Vote Rankings - {{ server_name }}{% endblock %}

{% block content %}
<h1><i class="fa fa-check-square"></i> Top Voters</h1>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Vote Rankings - Last 30 Days</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Username</th>
                    <th>Total Votes</th>
                </tr>
            </thead>
            <tbody>
            {% for voter in rankings %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ voter.username }}</td>
                    <td><span class="label label-primary">{{ voter.vote_count }}</span></td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center">No vote data available</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<a href="/rankings" class="btn btn-default">
    <i class="fa fa-arrow-left"></i> Back to Rankings
</a>
{% endblock %}
