{% extends "layout.twig" %}

{% block content %}
<!-- Hero Slider -->
<div class="hero-slider">
    <div class="slider-content">
        <h1><i class="fa fa-gamepad"></i> Welcome to {{ server_name }}</h1>
        <p>Experience the best MU Online private server with high rates, unique features, and an active community!</p>
        <div>
            <a href="/register" class="btn btn-primary btn-lg"><i class="fa fa-user-plus"></i> Create Account</a>
            <a href="/downloads" class="btn btn-secondary btn-lg"><i class="fa fa-download"></i> Download Client</a>
        </div>
    </div>
</div>

<!-- Main Content Grid -->
<div class="layout-grid">
    <!-- Main Content Area -->
    <div class="main-content">
        {% block main_content %}
            <div class="card">
                <div class="card-body">
                    <p class="text-center" style="padding: 40px 0;">Content goes here</p>
                </div>
            </div>
        {% endblock %}
    </div>

    <!-- Sidebar -->
    <div class="sidebar">
        <!-- Server Stats Widget -->
        <div class="widget">
            <div class="widget-title">
                <i class="fa fa-server"></i> Server Status
            </div>
            <div class="server-stats">
                <div class="stat-item">
                    <div>
                        <div class="stat-label">Online Players</div>
                        <div class="stat-value">{{ online_count|default(0) }}</div>
                    </div>
                    <i class="fa fa-users fa-2x text-orange"></i>
                </div>
                <div class="stat-item">
                    <div>
                        <div class="stat-label">Total Accounts</div>
                        <div class="stat-value">{{ total_accounts|default(0) }}</div>
                    </div>
                    <i class="fa fa-user fa-2x text-red"></i>
                </div>
                <div class="stat-item">
                    <div>
                        <div class="stat-label">Characters</div>
                        <div class="stat-value">{{ total_characters|default(0) }}</div>
                    </div>
                    <i class="fa fa-gamepad fa-2x text-orange"></i>
                </div>
            </div>
        </div>

        <!-- Quick Links Widget -->
        <div class="widget">
            <div class="widget-title">
                <i class="fa fa-link"></i> Quick Links
            </div>
            <ul>
                <li>
                    <a href="/rankings">
                        <span><i class="fa fa-trophy"></i> Rankings</span>
                        <i class="fa fa-angle-right"></i>
                    </a>
                </li>
                <li>
                    <a href="/downloads">
                        <span><i class="fa fa-download"></i> Downloads</span>
                        <i class="fa fa-angle-right"></i>
                    </a>
                </li>
                <li>
                    <a href="/usercp">
                        <span><i class="fa fa-dashboard"></i> User Panel</span>
                        <i class="fa fa-angle-right"></i>
                    </a>
                </li>
                <li>
                    <a href="/donation">
                        <span><i class="fa fa-credit-card"></i> Donate</span>
                        <i class="fa fa-angle-right"></i>
                    </a>
                </li>
                <li>
                    <a href="/info">
                        <span><i class="fa fa-info-circle"></i> Server Info</span>
                        <i class="fa fa-angle-right"></i>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Top Players Widget -->
        <div class="widget">
            <div class="widget-title">
                <i class="fa fa-star"></i> Top Players
            </div>
            {% if top_players %}
                <table class="table table-condensed" style="margin-bottom: 0;">
                    <thead>
                        <tr>
                            <th style="width: 30px;">#</th>
                            <th>Name</th>
                            <th style="text-align: right;">Level</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for player in top_players|slice(0, 5) %}
                        <tr>
                            <td><span class="label label-default">{{ loop.index }}</span></td>
                            <td>
                                <a href="/profile/player/{{ player.Name }}" class="text-orange">
                                    <strong>{{ player.Name }}</strong>
                                </a>
                            </td>
                            <td style="text-align: right;">
                                <span class="text-red"><strong>{{ player.cLevel }}</strong></span>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                <div style="text-align: center; margin-top: 15px;">
                    <a href="/rankings" class="btn btn-secondary btn-sm">
                        View All Rankings <i class="fa fa-arrow-right"></i>
                    </a>
                </div>
            {% else %}
                <p class="text-center" style="padding: 20px 0; color: var(--text-secondary);">
                    No players yet. Be the first!
                </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
