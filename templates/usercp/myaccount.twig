{% extends "layout.twig" %}

{% block title %}My Account - {{ server_name }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-3">
        {% include 'usercp/sidebar.twig' %}
    </div>

    <div class="col-md-9">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-user"></i> My Account Information</h3>
            </div>
            <div class="panel-body">
                {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
                {% endif %}

                {% if success %}
                <div class="alert alert-success">{{ success }}</div>
                {% endif %}

                <dl class="dl-horizontal">
                    <dt>Username:</dt>
                    <dd><strong>{{ account.memb___id }}</strong></dd>

                    <dt>Email:</dt>
                    <dd>{{ account.mail_addr }}</dd>

                    <dt>Credits:</dt>
                    <dd><span class="label label-success">{{ account.credits|default(0) }}</span>
                        <a href="/donation" class="btn btn-xs btn-success">Buy More</a>
                    </dd>

                    <dt>Member Since:</dt>
                    <dd>{{ account.memb_join|default('N/A') }}</dd>

                    <dt>Last Login:</dt>
                    <dd>{{ account.memb_last|default('N/A') }}</dd>

                    <dt>Account Status:</dt>
                    <dd><span class="label label-success">Active</span></dd>
                </dl>

                <hr>

                <h4>Quick Actions</h4>
                <div class="btn-group" role="group">
                    <a href="/usercp/myemail" class="btn btn-primary"><i class="fa fa-envelope"></i> Change Email</a>
                    <a href="/usercp/mypassword" class="btn btn-warning"><i class="fa fa-key"></i> Change Password</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
