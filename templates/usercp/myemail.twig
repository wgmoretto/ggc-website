{% extends "layout.twig" %}

{% block title %}Change Email - {{ server_name }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-3">
        {% include 'usercp/sidebar.twig' %}
    </div>

    <div class="col-md-9">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-envelope"></i> Change Email Address</h3>
            </div>
            <div class="panel-body">
                {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
                {% endif %}

                {% if success %}
                <div class="alert alert-success">{{ success }}</div>
                {% endif %}

                <div class="alert alert-info">
                    <strong>Current Email:</strong> {{ account.mail_addr }}
                </div>

                <form method="POST" action="/usercp/myemail">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

                    <div class="form-group">
                        <label for="email">New Email Address</label>
                        <input type="email" class="form-control" id="email" name="email" required>
                        <p class="help-block">Enter your new email address</p>
                    </div>

                    <div class="form-group">
                        <label for="confirm_email">Confirm Email Address</label>
                        <input type="email" class="form-control" id="confirm_email" name="confirm_email" required>
                        <p class="help-block">Re-enter your new email address</p>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Update Email
                    </button>
                    <a href="/usercp" class="btn btn-default">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
