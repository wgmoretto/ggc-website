{% extends "layout.twig" %}

{% block title %}Vote for Rewards - {{ server_name }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-3">
        {% include 'usercp/sidebar.twig' %}
    </div>

    <div class="col-md-9">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-check"></i> Vote for Rewards</h3>
            </div>
            <div class="panel-body">
                {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
                {% endif %}

                {% if success %}
                <div class="alert alert-success">{{ success }}</div>
                {% endif %}

                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i>
                    Vote for our server on various top lists and earn rewards! You can vote every 12 hours.
                </div>

                <h4>Available Vote Sites</h4>

                {% for site in sites %}
                <div class="panel panel-default">
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-8">
                                <h4>{{ site.name }}</h4>
                                <p>
                                    <strong>Reward:</strong>
                                    <span class="label label-success">{{ site.credits_reward }} Credits</span>
                                </p>
                                <p>
                                    <strong>Vote Interval:</strong> Every {{ site.vote_interval }} hours
                                </p>
                            </div>
                            <div class="col-md-4 text-right">
                                <a href="{{ site.url }}" target="_blank" class="btn btn-primary btn-lg">
                                    <i class="fa fa-external-link"></i> Vote Now
                                </a>
                                <form method="POST" action="/usercp/vote" style="margin-top: 10px;">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <input type="hidden" name="site_id" value="{{ site.id }}">
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa fa-check"></i> Claim Reward
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}

                <hr>

                <h4>Recent Votes</h4>
                {% if votes %}
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Site</th>
                            <th>Credits Earned</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for vote in votes %}
                        <tr>
                            <td>{{ vote.site_name }}</td>
                            <td><span class="label label-success">{{ vote.credits_reward|default(0) }}</span></td>
                            <td>{{ vote.voted_at }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% else %}
                <p class="text-muted">You haven't voted yet. Start voting to earn rewards!</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
