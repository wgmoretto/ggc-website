{% extends "layout.twig" %}

{% block title %}Reset Character - {{ server_name }}{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-3">
        {% include 'usercp/sidebar.twig' %}
    </div>

    <div class="col-md-9">
        <div class="panel panel-danger">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-repeat"></i> Reset Character</h3>
            </div>
            <div class="panel-body">
                {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
                {% endif %}

                {% if success %}
                <div class="alert alert-success">{{ success }}</div>
                {% endif %}

                <div class="alert alert-danger">
                    <h4><i class="fa fa-exclamation-triangle"></i> Warning!</h4>
                    <p>Resetting your character will:</p>
                    <ul>
                        <li>Reset your level to 1</li>
                        <li>Reset all experience to 0</li>
                        <li>Increase your reset count by 1</li>
                        <li>Reward you with bonus Zen</li>
                        <li><strong>Your character must be offline!</strong></li>
                    </ul>
                </div>

                <form method="POST" action="/usercp/reset" onsubmit="return confirm('Are you sure you want to reset this character? This action cannot be undone!');">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

                    <div class="form-group">
                        <label for="character">Select Character to Reset</label>
                        <select class="form-control" id="character" name="character" required>
                            <option value="">-- Choose a character --</option>
                            {% for char in characters %}
                            <option value="{{ char.Name }}">
                                {{ char.Name }} (Level {{ char.cLevel }}, {{ char.Resets|default(0) }} resets)
                            </option>
                            {% endfor %}
                        </select>
                    </div>

                    <button type="submit" class="btn btn-danger">
                        <i class="fa fa-repeat"></i> Reset Character
                    </button>
                    <a href="/usercp" class="btn btn-default">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
