<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <link href="/assets/css/style.css" rel="stylesheet">
    {% block styles %}{% endblock %}
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-custom navbar-fixed-top">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#navbar">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="/">
                    <i class="fa fa-gamepad"></i> {{ server_name }}
                </a>
            </div>
            <div id="navbar" class="collapse navbar-collapse">
                <ul class="nav navbar-nav">
                    <li><a href="/"><i class="fa fa-home"></i> Home</a></li>
                    <li><a href="/news"><i class="fa fa-newspaper-o"></i> News</a></li>
                    <li><a href="/rankings"><i class="fa fa-trophy"></i> Rankings</a></li>
                    <li><a href="/downloads"><i class="fa fa-download"></i> Downloads</a></li>
                    <li><a href="/info"><i class="fa fa-info-circle"></i> Info</a></li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    {% if user %}
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                <i class="fa fa-user-circle"></i> {{ user }} <b class="caret"></b>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a href="/usercp"><i class="fa fa-dashboard"></i> Control Panel</a></li>
                                <li class="divider"></li>
                                <li><a href="/logout"><i class="fa fa-sign-out"></i> Logout</a></li>
                            </ul>
                        </li>
                    {% else %}
                        <li><a href="/login"><i class="fa fa-sign-in"></i> Login</a></li>
                        <li><a href="/register"><i class="fa fa-user-plus"></i> Register</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Wrapper -->
    <div class="main-wrapper">
        <div class="container-fluid content-container">
            {% block content %}{% endblock %}
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4 text-left">
                    <p><strong>{{ server_name }}</strong></p>
                    <p>{{ env('SERVER_VERSION', 'Season 6') }}</p>
                </div>
                <div class="col-md-4 text-center">
                    <p>&copy; {{ "now"|date("Y") }} {{ server_name }}. All rights reserved.</p>
                </div>
                <div class="col-md-4 text-right">
                    <p>
                        <a href="/info/terms" style="color: #b0b0b0;">Terms</a> |
                        <a href="/info/privacy" style="color: #b0b0b0;">Privacy</a> |
                        <a href="/contact" style="color: #b0b0b0;">Contact</a>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-2.2.4.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>

    <!-- CSRF Token Auto-Injection -->
    <script>
    (function() {
        // Get CSRF token from meta tag or global variable
        var csrfToken = '{{ csrf_token() }}';

        // Auto-inject CSRF token into all forms on page load
        document.addEventListener('DOMContentLoaded', function() {
            injectCsrfTokens();
        });

        // Also inject on AJAX complete (for dynamically loaded content)
        if (typeof jQuery !== 'undefined') {
            jQuery(document).ajaxComplete(function() {
                injectCsrfTokens();
            });
        }

        function injectCsrfTokens() {
            var forms = document.querySelectorAll('form[method="POST"], form[method="post"], form[method="PUT"], form[method="put"], form[method="DELETE"], form[method="delete"]');

            forms.forEach(function(form) {
                // Check if form already has csrf_token field
                var existingToken = form.querySelector('input[name="csrf_token"]');

                if (!existingToken) {
                    // Create and inject CSRF token input
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'csrf_token';
                    input.value = csrfToken;
                    form.insertBefore(input, form.firstChild);
                } else {
                    // Update existing token value (in case it was empty or wrong)
                    existingToken.value = csrfToken;
                }
            });
        }
    })();
    </script>

    {% block scripts %}{% endblock %}
</body>
</html>
