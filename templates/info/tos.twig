{% extends "layout.twig" %}

{% block title %}Terms of Service - {{ server_name }}{% endblock %}

{% block content %}
<h1>Terms of Service</h1>

<div class="panel panel-default">
    <div class="panel-body">
        <h3>1. Acceptance of Terms</h3>
